## Off CGI, Off directs without index.files, Off SSI, use simbolic links on files or directs
Options All -ExecCGI -Indexes -Includes +FollowSymLinks

############# ModRewriter for other mirrors
<IfModule mod_rewrite.c>
Options -MultiViews
RewriteEngine on

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.*)$ $1.php [NC,L]

RewriteRule ^services/([0-9a-zA-z_-]+) service.php?service=$1 [L] 

RewriteRule ^investorcorner/([0-9a-zA-z_-]+) investor-corner.php?investor-doc-url=$1 [L] 

RewriteRule ^blogs/([0-9a-zA-z_-]+) blog-details.php?blog=$1 [L] 

RewriteRule ^job/([0-9a-zA-z_-]+) job-details.php?job=$1 [L] 

RewriteRule ^verifier/([0-9a-zA-z_-]+) apply-now.php?token=$1 [L] 

RewriteRule ^sitemap_index\.xml/?$ sitemaps.php

#RewriteRule ^(.*)$ http://www.%{HTTP_HOST}/$1 [L,R=301]
#RewriteRule ^sitemap\.xml/?$ sitemap.php


RewriteCond ${REQUEST_URI} ^.+$
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d [OR]
RewriteCond %{REQUEST_FILENAME} -l
RewriteRule ^ - [L]

RewriteBase /
